# Copy to .env on the server and fill in the secrets. Never commit the real .env.
APP_NAME="District Outbreak Watch"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://public-health-surveillance.joseneous.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log       # use reverb only if you run `php artisan reverb:start` and set SURVEILLANCE_REALTIME=true

# Behind a load balancer or reverse proxy, list its address (or * if it is the only way in).
TRUSTED_PROXIES=

SURVEILLANCE_SYNTHETIC_DATA=true   # set false once real data is loaded
SURVEILLANCE_FORCE_HTTPS=true
SURVEILLANCE_HSTS=true
SURVEILLANCE_REALTIME=false

# Mail: until a provider is set the mailer "log" writes messages to storage/logs instead of sending them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="alerts@joseneous.com"
MAIL_FROM_NAME="${APP_NAME}"
